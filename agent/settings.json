{
  "lastChangelogVersion": "0.82.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "retry": {
    "enabled": true
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-add-dir",
    "npm:@firstpick/pi-skill-deep-research",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-agent-browser-native"
  ],
  "externalEditor": "code --wait",
  "subagents": {
    "defaultModel": "gpt-5.6-sol",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "openai-codex/gpt-5.4-mini"
        ]
      },
      "delegate": {
        "model": "gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "openai-codex/gpt-5.4-mini"
        ]
      },
      "context-builder": {
        "model": "gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.4-mini"
        ]
      },
      "researcher": {
        "model": "gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.4-mini"
        ]
      },
      "worker": {
        "model": "gpt-5.6-terra",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.4"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "reviewer": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "oracle": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "advisor": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      }
    }
  },
  "theme": "dark",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "nvidia/z-ai/glm-5.2",
    "openai-codex-personal/gpt-5.6-sol",
    "openai-codex-personal/gpt-5.6-luna",
    "openai-codex-personal/gpt-5.6-terra"
  ],
  "compaction": {
    "enabled": true
  }
}