{
  "lastChangelogVersion": "0.86.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "medium",
  "retry": {
    "enabled": true
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-add-dir",
    "npm:@firstpick/pi-skill-deep-research",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-agent-browser-native",
    "npm:pi-web-access",
    "npm:@langfuse/pi-observability-plugin"
  ],
  "externalEditor": "code --wait",
  "cacheWarming": "idle",
  "subagents": {
    "defaultModel": "gpt-6-sol",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "gpt-6-luna",
        "thinking": "low"
      },
      "delegate": {
        "model": "gpt-6-luna",
        "thinking": "low"
      },
      "context-builder": {
        "model": "gpt-5.6-terra",
        "thinking": "medium"
      },
      "researcher": {
        "model": "gpt-5.6-terra",
        "thinking": "medium"
      },
      "worker": {
        "model": "gpt-5.6-terra",
        "thinking": "high"
      },
      "planner": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "high"
      },
      "reviewer": {
        "model": "gpt-6-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "gpt-6-sol",
        "thinking": "high"
      },
      "advisor": {
        "model": "gpt-6-sol",
        "thinking": "high"
      }
    }
  },
  "theme": "dark",
  "enabledModels": [
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-luna",
    "openai-codex-personal/gpt-6-sol",
    "openai-codex-personal/gpt-6-luna",
    "openai-codex-personal/gpt-5.6-terra",
    "openai-codex/gpt-6-astra"
  ],
  "compaction": {
    "enabled": true
  }
}